{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/app.cpp",
                "-o",
                "${workspaceFolder}/misha.exe",
                "-lSDL2"
            ],
            "options": {
                "env": { "PATH": "C:/msys64/ucrt64/bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
